---
// Header of the four activity pages (Prestations, Formations, Boutique, Location), copied
// from the current WordPress site (client request, 2026-11-19): white bar, the activity's
// LDL logo + "| ACTIVITY" in its colour, the menu in Montserrat with the current page in
// its colour and underlined, account, cart with its count, and the activity's button.
// Measured on www.lesdroneslyonnais.com: bar 63px, menu 14px/600, label 17px/700, button
// 11px/600, 12px 24px padding, 3px radius; hover: white button, text in the colour.
// One deliberate difference: on WordPress the
// Prestations button has a green border (a slip, the other pages use their own colour).
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/montserrat/latin-700.css';
import { Image } from 'astro:assets';
import ldlPrestations from '../../assets/brand/ldl-prestations.png';
import ldlFormations from '../../assets/brand/ldl-formations.png';
import ldlBoutique from '../../assets/brand/ldl-boutique.png';
import ldlLocation from '../../assets/brand/ldl-location.png';
import { ACTIVITIES, NAV, SITE, type ActivityId } from '../../data/site';

/** An activity, or 'general' for pages that belong to none (account area, contact). */
export type HeaderVariant = ActivityId | 'general';

interface Props {
  activity: HeaderVariant;
  /** Menu item to mark as the current page when it is not the activity (the contact page). */
  current?: 'contact';
}
const { activity, current: currentItem } = Astro.props;

// Colours, logos and buttons of the WordPress headers. 'general' is the WordPress header
// of Mon compte and Contact: "| LES DRONES LYONNAIS" in black, blue-dot logo, black
// "Contactez-nous" button with the chat icon.
const BRAND = {
  prestations: { color: '#0835bd', logo: ldlPrestations, cta: 'Demander un conseil', chat: false },
  formations: { color: '#296321', logo: ldlFormations, cta: 'Demander un conseil', chat: false },
  boutique: { color: '#04082d', logo: ldlBoutique, cta: 'Conseil & devis', chat: true },
  location: { color: '#e25d02', logo: ldlLocation, cta: 'Réserver maintenant', chat: false },
  general: { color: '#000000', logo: ldlPrestations, cta: 'Contactez-nous', chat: true },
} as const;
const brand = BRAND[activity];
const current = activity === 'general' ? { label: SITE.name, href: '/' } : ACTIVITIES[activity];

const items = [
  { label: 'Accueil', href: '/', current: false },
  ...NAV.map((a) => ({ label: a.label, href: a.href, current: a.id === activity })),
  { label: 'Contact', href: SITE.contactPath, current: currentItem === 'contact' },
];
---

<header class="ldl-header" style={`--brand: ${brand.color}`}>
  <div class="bar">
    <div class="brand">
      <a href="/" class="mark" aria-label={`${SITE.name}, accueil`}>
        <Image src={brand.logo} alt="" height={25} densities={[1, 2, 3]} loading="eager" />
      </a>
      <a href={current.href} class="label">| {current.label}</a>
    </div>

    <nav aria-label="Navigation principale" class="nav">
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="tools">
      <!-- Customer / admin area (signed out: /compte/ sends to /connexion/). -->
      <a href="/compte/" class="icon" aria-label="Mon compte">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="7.5" r="4.25" />
          <path d="M3.75 21.25v-1.5A4.75 4.75 0 0 1 8.5 15h7a4.75 4.75 0 0 1 4.75 4.75v1.5" />
        </svg>
      </a>

      <!-- Cart (CartDrawer); the count shows even at 0, as on WordPress. -->
      <button type="button" class="icon cart" data-cart-open aria-label="Panier, 0 article">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M1.5 3h3l2.4 11.2a1.5 1.5 0 0 0 1.47 1.18h9.86a1.5 1.5 0 0 0 1.46-1.16L21.5 7H6" />
          <circle cx="9" cy="20" r="1.4" />
          <circle cx="18" cy="20" r="1.4" />
        </svg>
        <span class="count" data-cart-count data-cart-count-always aria-hidden="true">0</span>
      </button>

      <a href={SITE.contactPath} class="cta">
        {
          brand.chat && (
            <svg viewBox="0 0 512 512" aria-hidden="true">
              <path d="M256 32C114.6 32 0 125.1 0 240c0 49.6 21.4 95 57 130.7C44.5 421.1 2.7 466 2.2 466.5c-2.2 2.3-2.8 5.7-1.5 8.7S4.8 480 8 480c66.3 0 116-31.8 140.6-51.4 32.7 12.3 69 19.4 107.4 19.4 141.4 0 256-93.1 256-208S397.4 32 256 32z" />
            </svg>
          )
        }
        {brand.cta}
      </a>

      <!-- Below 1280px: a native disclosure, no script needed. -->
      <details class="menu">
        <summary aria-label="Menu">
          <span class="burger" aria-hidden="true"></span>
        </summary>
        <div class="panel">
          <ul>
            {
              items.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <a href={SITE.contactPath} class="cta cta-block">{brand.cta}</a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .ldl-header {
    position: relative;
    z-index: 30;
    background: #fff;
    color: #000;
    font-family: 'Montserrat', var(--font-sans);
  }
  .bar {
    display: grid;
    grid-template-columns: minmax(max-content, 1fr) auto minmax(max-content, 1fr);
    align-items: center;
    gap: 24px;
    height: 63px;
    padding-inline: clamp(16px, 3.2vw, 64px);
  }

  /* Logo + "| ACTIVITY" */
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .mark {
    display: block;
  }
  .mark img {
    display: block;
    height: 25px;
    width: auto;
  }
  .label {
    font-size: 17px;
    font-weight: 700;
    line-height: 20px;
    color: var(--brand);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Menu */
  .nav ul {
    display: flex;
    align-items: center;
    /* 50px between items on large screens, as on WordPress; tighter down to 1280px. */
    gap: clamp(16px, calc(4.4vw - 34px), 50px);
  }
  .nav a {
    display: block;
    padding-block: 10px;
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    text-transform: uppercase;
    white-space: nowrap;
    color: #000;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: transparent;
    transition:
      color 150ms ease-out,
      text-decoration-color 150ms ease-out;
  }
  .nav a[aria-current='page'] {
    color: var(--brand);
    text-decoration-color: currentColor;
  }
  @media (hover: hover) and (pointer: fine) {
    .nav a:hover {
      color: var(--brand);
    }
  }

  /* Account, cart, button */
  .tools {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
  }
  .icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    color: #000;
    cursor: pointer;
  }
  .icon svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .count {
    position: absolute;
    top: 0;
    right: -1px;
    display: grid;
    place-items: center;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    font-size: 10px;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: #fff;
    background: #000;
    border-radius: 999px;
  }
  @media (hover: hover) and (pointer: fine) {
    .icon:hover {
      color: var(--brand);
    }
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-left: 8px;
    padding: 12px 24px;
    font-size: 11px;
    font-weight: 600;
    line-height: 11px;
    text-transform: uppercase;
    white-space: nowrap;
    color: #fff;
    background: var(--brand);
    border: 1px solid var(--brand);
    border-radius: 3px;
    transition:
      background-color 150ms ease-out,
      color 150ms ease-out;
  }
  .cta svg {
    width: 11px;
    height: 11px;
    fill: currentColor;
  }
  @media (hover: hover) and (pointer: fine) {
    .cta:hover {
      color: var(--brand);
      background: #fff;
    }
  }
  .cta:focus-visible,
  .nav a:focus-visible,
  .icon:focus-visible,
  .brand a:focus-visible,
  .menu summary:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
  }

  /* Mobile menu (below 1280px, like the WordPress tablet / phone header) */
  .menu {
    display: none;
  }
  .menu summary {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    cursor: pointer;
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 21px;
    height: 3px;
    border-radius: 2px;
    background: #000;
    transition:
      transform 200ms var(--ease-out-strong),
      background-color 150ms ease-out;
  }
  .burger {
    position: relative;
  }
  .burger::before,
  .burger::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .burger::before {
    transform: translateY(-7px);
  }
  .burger::after {
    transform: translateY(7px);
  }
  .menu[open] .burger {
    background: transparent;
  }
  .menu[open] .burger::before {
    transform: rotate(45deg);
  }
  .menu[open] .burger::after {
    transform: rotate(-45deg);
  }
  .panel {
    position: absolute;
    inset: 100% 0 auto;
    padding: 4px clamp(16px, 3.2vw, 64px) 20px;
    background: #fff;
    border-top: 1px solid #ececec;
    box-shadow: 0 12px 24px rgb(0 0 0 / 0.08);
  }
  .panel li + li {
    border-top: 1px solid #ececec;
  }
  .panel li a {
    display: block;
    padding-block: 14px;
    font-size: 15px;
    font-weight: 600;
    text-transform: uppercase;
    color: #000;
  }
  .panel li a[aria-current='page'] {
    color: var(--brand);
  }
  .cta-block {
    display: flex;
    margin: 12px 0 0;
    padding-block: 15px;
  }
  .menu[open] .panel {
    animation: panel-in 200ms var(--ease-out-strong);
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (max-width: 1279px) {
    .nav,
    .tools > .cta {
      display: none;
    }
    .menu {
      display: block;
    }
    .bar {
      grid-template-columns: auto auto;
      justify-content: space-between;
    }
    .tools {
      gap: 10px;
    }
  }
  @media (max-width: 599px) {
    .bar {
      height: 56px;
      gap: 12px;
    }
    .mark img {
      height: 20px;
    }
    .label {
      font-size: 14px;
    }
    .tools {
      gap: 4px;
    }
  }
  @media (max-width: 359px) {
    .label {
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .burger,
    .burger::before,
    .burger::after,
    .nav a,
    .cta {
      transition: none;
    }
    .menu[open] .panel {
      animation: none;
    }
  }
</style>
