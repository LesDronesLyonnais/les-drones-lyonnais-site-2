---
// The four commitments, on their own under the map of France (CoverageMap) since the map
// was redone on 2026-11-21. Content in data/home.ts.
import Square from '../ui/Square.astro';
import { COMMITMENTS } from '../../data/home';
---

<section aria-labelledby="commitments-title" class="section-pad bg-paper">
  <div class="wrap">
    <h2 id="commitments-title" class="display flex items-start gap-4 text-[clamp(1.8rem,3vw,2.6rem)]" data-reveal>
      <Square color="var(--color-gold)" class="mt-[0.2em] size-3.5 shrink-0" />Nos engagements
    </h2>
    <ul class="mt-10 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        COMMITMENTS.map((item, i) => (
          <li class="commitment pt-5" data-reveal style={{ '--i': i }}>
            <h3 class="flex items-center gap-2 text-lg font-bold [font-stretch:112%]">
              <Square color="var(--color-gold)" />
              {item.title}
            </h3>
            <p class="mt-2 leading-relaxed text-ink-soft">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .commitment {
    border-top: 2px solid var(--color-gold);
  }
</style>
