---
// One drone family in the shop: its photo, its promise, "Choisissez votre version" (the
// drone's versions side by side, cheapest first, as editorial rows) and the accessories
// made for it (a row you can scroll). Everything links to the product pages.
import { Image } from 'astro:assets';
import { productPhoto } from '../../lib/product-photo';
import { droneClass, formatPrice, productUrl } from '../../data/catalog';
import { accessoriesOf, fromPrice, versionLabel, versionsOf, type Family } from '../../data/shop';

interface Props {
  family: Family;
  /** Photo on the right (alternating blocks). */
  flip?: boolean;
}
const { family, flip = false } = Astro.props;
const versions = await Promise.all(versionsOf(family).map(async (p) => ({ p, photo: await productPhoto(p, 1), cls: droneClass(p), label: versionLabel(family, p) })));
const accessories = await Promise.all(accessoriesOf(family).map(async (p) => ({ p, photo: await productPhoto(p, 1) })));
const from = fromPrice(versions.map((v) => v.p));
const classes = [...new Set(versions.map((v) => v.cls).filter(Boolean))];
---

<article id={`famille-${family.id}`} class:list={['family', flip && 'flip']} aria-labelledby={`famille-${family.id}-title`}>
  <div class="visual viewfinder">
    <Image src={family.photo} alt="" widths={[480, 720, 960]} sizes="(min-width: 1024px) 40vw, 100vw" loading="lazy" style={{ objectPosition: family.focus ?? '50% 50%' }} />
  </div>

  <div class="content">
    <h3 id={`famille-${family.id}-title`} class="name">{family.name}</h3>
    <p class="tagline">{family.tagline}</p>
    <p class="meta">
      {from !== null && (
        <span>
          À partir de <strong>{formatPrice(from)} TTC</strong>
        </span>
      )}
      {classes.map((c) => (
        <span class="badge hud-text">Classe {c}</span>
      ))}
    </p>

    {
      versions.length > 0 && (
        <>
          <p class="hud-text label">Choisissez votre version · {versions.length}</p>
          <ul class="versions">
            {versions.map(({ p, photo, cls, label }) => (
              <li>
                <a href={productUrl(p)} class="version">
                  <span class="thumb">{photo && <img src={photo.src} srcset={photo.srcset} sizes="64px" width="64" height="64" alt="" loading="lazy" decoding="async" />}</span>
                  <span class="v-name">
                    {label}
                    {cls && <span class="v-cls hud-text">Classe {cls}</span>}
                  </span>
                  <span class="v-price">
                    <strong>{formatPrice(p.priceTTC)}</strong>
                    <span>{formatPrice(p.priceHT)} HT</span>
                  </span>
                  <span class="v-go" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }

    {
      accessories.length > 0 && (
        <>
          <p class="hud-text label">Accessoires compatibles · {accessories.length}</p>
          <ul class="accessories">
            {accessories.map(({ p, photo }) => (
              <li>
                <a href={productUrl(p)} class="acc">
                  <span class="acc-media">{photo && <img src={photo.src} srcset={photo.srcset} sizes="120px" width="120" height="120" alt="" loading="lazy" decoding="async" />}</span>
                  <span class="acc-name">{p.name}</span>
                  <span class="acc-price">{formatPrice(p.priceTTC)} TTC</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>
</article>

<style>
  .family {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(20px, 3vw, 56px);
    padding-block: clamp(32px, 4vw, 56px);
    border-top: 1px solid var(--color-line);
  }
  @media (min-width: 1024px) {
    .family {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
    .family.flip .visual {
      order: 2;
    }
    .visual {
      position: sticky;
      top: 24px;
    }
  }
  .visual {
    --vf: rgb(255 255 255 / 0.85);
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: #111;
  }
  @media (min-width: 1024px) {
    .visual {
      aspect-ratio: 4 / 5;
    }
  }
  .visual :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .content {
    min-width: 0;
  }
  .name {
    font-stretch: 112%;
    font-size: clamp(1.7rem, 2.8vw, 2.4rem);
    font-weight: 700;
    line-height: 1.05;
  }
  .tagline {
    margin-top: 8px;
    font-size: 17px;
    color: var(--color-ink-soft);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin-top: 14px;
    font-size: 15px;
    color: var(--color-muted);
  }
  .meta strong {
    font-size: 18px;
    color: var(--color-ink);
  }
  .badge,
  .v-cls {
    padding: 3px 8px;
    color: #fff;
    background: var(--color-ink);
  }
  .label {
    margin-top: clamp(24px, 3vw, 32px);
    color: var(--color-muted);
  }

  /* Versions: editorial rows */
  .versions {
    margin-top: 10px;
    border-bottom: 1px solid var(--color-line);
  }
  .version {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto 20px;
    align-items: center;
    gap: 16px;
    padding-block: 10px;
    border-top: 1px solid var(--color-line);
    transition: background-color 150ms ease-out;
  }
  .thumb img {
    display: block;
    width: 64px;
    height: 64px;
    object-fit: contain;
    background: #fff;
  }
  .v-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
  }
  .v-cls {
    font-size: 11px;
    font-weight: 500;
  }
  .v-price {
    display: grid;
    justify-items: end;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .v-price strong {
    font-size: 16px;
  }
  .v-price span {
    font-size: 12px;
    color: var(--color-muted);
  }
  .v-go {
    color: var(--color-gold-deep);
    transition: transform 200ms var(--ease-out-strong);
  }
  @media (hover: hover) and (pointer: fine) {
    .version:hover {
      background: rgb(0 0 0 / 0.03);
    }
    .version:hover .v-go {
      transform: translateX(3px);
    }
  }
  .version:focus-visible,
  .acc:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
  }

  /* Accessories: a row to scroll */
  .accessories {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 148px;
    gap: 12px;
    margin-top: 10px;
    padding-bottom: 8px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  .accessories li {
    scroll-snap-align: start;
  }
  .acc {
    display: grid;
    gap: 6px;
  }
  .acc-media {
    display: block;
    aspect-ratio: 1;
    background: #fff;
    border: 1px solid var(--color-line);
  }
  .acc-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .acc-name {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 13px;
    line-height: 1.35;
  }
  .acc-price {
    font-size: 13px;
    font-weight: 600;
  }
  @media (hover: hover) and (pointer: fine) {
    .acc:hover .acc-media {
      border-color: var(--color-ink);
    }
  }

  @media (max-width: 479px) {
    .version {
      grid-template-columns: 52px minmax(0, 1fr) auto;
      gap: 12px;
    }
    .thumb img {
      width: 52px;
      height: 52px;
    }
    .v-go {
      display: none;
    }
  }
</style>
