---
// The categories band of the shop, as on the current site: five tabs (Grand public, Drones
// pro, Par réglementation, Capteurs, Accessoires), each showing its categories as tiles with
// a product photo and a count, plus Pop's "need help choosing?" card. The first tab is open
// on arrival; hovering a tab opens it (real pointer only); arrows, Home and End move between
// tabs. Tiles filter the catalogue (?filtre=). Without JavaScript all panels show one after
// the other. Used on /boutique/ under the showcase (client request, 2026-11-20) and by ShopHero.
import { Image } from 'astro:assets';
import popSupport from '../../assets/pop/support.webp';
import { SHOP_MENU, forSale } from '../../data/catalog';
import { productPhoto } from '../../lib/product-photo';

const tabs = await Promise.all(
  SHOP_MENU.map(async (tab) => ({
    ...tab,
    tiles: (
      await Promise.all(
        tab.tiles.map(async (tile) => {
          const items = forSale.filter(tile.match);
          // The tile shows the most representative product: the first with a photo.
          const photo = items.length ? await productPhoto(items[0], 1) : null;
          return { ...tile, count: items.length, photo };
        }),
      )
    ).filter((t) => t.count > 0),
  })),
);
---

<section class="menu" aria-label="Catégories de la boutique" data-mega>
  <div class="wrap">
    <div class="tabs" role="tablist" aria-label="Catégories de la boutique">
      {
        tabs.map((tab, i) => (
          <button type="button" role="tab" id={`tab-${tab.id}`} aria-controls={`panel-${tab.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            {tab.label}
          </button>
        ))
      }
      <span class="tab-bar" aria-hidden="true"></span>
    </div>
  </div>

  <div class="panels wrap">
    {
      tabs.map((tab, i) => (
        <div class="panel" role="tabpanel" id={`panel-${tab.id}`} aria-labelledby={`tab-${tab.id}`} data-active={i === 0 || undefined}>
          <ul class="tiles">
            {tab.tiles.map((tile, k) => (
              <li style={{ '--k': k }}>
                <a class="tile" href={`/boutique/?filtre=${tile.id}#catalogue`} data-goto-filter={tile.id}>
                  <span class="tile-img">
                    {tile.photo && <img src={tile.photo.src} srcset={tile.photo.srcset} sizes="140px" alt="" loading="lazy" decoding="async" />}
                  </span>
                  <span class="tile-body">
                    <span class="tile-name">{tile.label}</span>
                    <span class="tile-text">{tile.text}</span>
                    <span class="tile-count hud-text">
                      {tile.count} produit{tile.count > 1 ? 's' : ''}
                    </span>
                  </span>
                </a>
              </li>
            ))}
            <li class="help" style={{ '--k': tab.tiles.length }}>
              <button type="button" class="help-card" data-pop-open data-pop-ask="Quel drone choisir ?">
                <span class="help-title">Besoin d’aide pour choisir ?</span>
                <span class="help-text">Pop vous pose trois questions et vous oriente.</span>
                <Image src={popSupport} alt="" width={150} densities={[1, 2]} class="help-pop" />
              </button>
            </li>
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* ---------- Tabs ---------- */
  .menu {
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
  }
  .tabs {
    position: relative;
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs button {
    flex-shrink: 0;
    min-height: 58px;
    padding: 0 18px;
    font-weight: 700;
    color: var(--color-muted);
    transition: color 200ms ease;
  }
  .tabs button[aria-selected='true'] {
    color: var(--color-ink);
  }
  @media (hover: hover) and (pointer: fine) {
    .tabs button:hover {
      color: var(--color-ink);
    }
  }
  .tabs button:focus-visible {
    outline-offset: -4px;
  }
  .tab-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 3px;
    width: var(--w, 0);
    background: var(--color-gold);
    transform: translateX(var(--x, 0));
    transition:
      transform 400ms var(--ease-out-strong),
      width 400ms var(--ease-out-strong);
  }

  /* ---------- Panels ---------- */
  .panels {
    position: relative;
    padding-block: 24px 32px;
  }
  .panel {
    display: none;
  }
  .panel[data-active] {
    display: block;
  }
  :global(html:not(.js)) .panel {
    display: block;
    margin-bottom: 24px;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 12px;
  }
  .panel[data-active] .tiles > li {
    animation: tile-in 450ms var(--ease-out-strong) backwards;
    animation-delay: calc(var(--k) * 40ms);
  }
  @keyframes tile-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .tile {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 14px;
    align-items: center;
    height: 100%;
    padding: 12px;
    border: 1px solid var(--color-line);
    background: #fff;
    transition:
      border-color 200ms ease,
      transform 300ms var(--ease-out-strong);
  }
  .tile-img {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
  }
  .tile-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 500ms var(--ease-out-strong);
  }
  .tile-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .tile-name {
    font-weight: 700;
    font-stretch: 112%;
  }
  .tile-text {
    font-size: 14px;
    line-height: 1.4;
    color: var(--color-ink-soft);
  }
  .tile-count {
    margin-top: 4px;
    color: var(--color-gold-deep);
  }
  @media (hover: hover) and (pointer: fine) {
    .tile:hover {
      border-color: var(--color-ink);
      transform: translateY(-2px);
    }
    .tile:hover .tile-img img {
      transform: scale(1.08);
    }
  }

  /* Pop's help card, like the "Besoin d'aide pour choisir ?" card of the current site. */
  .help-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    height: 100%;
    min-height: 122px;
    padding: 16px 130px 16px 18px;
    overflow: hidden;
    text-align: left;
    color: #fff;
    background: var(--color-ink);
    transition: background-color 200ms ease;
  }
  .help-title {
    font-weight: 700;
    font-stretch: 112%;
    line-height: 1.2;
  }
  .help-text {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.4;
    color: rgb(255 255 255 / 0.7);
  }
  .help-pop {
    position: absolute;
    right: -6px;
    bottom: -10px;
    width: 130px;
    height: auto;
    transition: transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .help-card:hover {
      background: #1c1c1c;
    }
    .help-card:hover .help-pop {
      transform: translateY(-6px) rotate(-3deg);
    }
  }

  @media (max-width: 640px) {
    .tile {
      grid-template-columns: 72px 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel[data-active] .tiles > li {
      animation: none;
    }
    .tile,
    .tile-img img,
    .help-pop,
    .tab-bar {
      transition: none;
    }
  }
</style>

<script>
  // Tabs with keyboard support (arrows, Home, End) and a sliding gold bar.
  document.querySelectorAll<HTMLElement>('[data-mega]').forEach((mega) => {
    const tabs = [...mega.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...mega.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    const bar = mega.querySelector<HTMLElement>('.tab-bar')!;
    const place = (tab: HTMLElement) => {
      bar.style.setProperty('--x', `${tab.offsetLeft}px`);
      bar.style.setProperty('--w', `${tab.offsetWidth}px`);
    };
    const select = (i: number, focus = false) => {
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      panels.forEach((p, k) => p.toggleAttribute('data-active', k === i));
      place(tabs[i]);
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      // Hovering a tab opens it, like a mega menu (only with a real pointer).
      t.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && select(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        const to = { ArrowRight: (i + 1) % n, ArrowLeft: (i - 1 + n) % n, Home: 0, End: n - 1 }[e.key];
        if (to !== undefined) {
          e.preventDefault();
          select(to, true);
        }
      });
    });
    place(tabs[0]);
    addEventListener('resize', () => place(tabs.find((t) => t.getAttribute('aria-selected') === 'true')!));
  });
</script>
