---
// The categories band of the shop (client, 2026-11-20: keep the categories of the current
// site under the showcase; then "make it clearer, more modern, and centred").
// Centred: a segmented control of five tabs, each with an icon (Grand public, Drones pro,
// Selon votre permis, Capteurs, Accessoires), a sentence saying what the open tab holds,
// then its categories as cards (the cheapest product's photo, or the class itself for the
// permit tab), name, one line, product count. Phones: the cards scroll sideways. Tabs open
// on click only; arrows, Home and End move between them. Cards filter the catalogue
// (?filtre=). Without JavaScript every panel shows, one after the other.
import { Image } from 'astro:assets';
import popHead from '../../assets/pop/tete.webp';
import { SHOP_MENU, forSale, productImages } from '../../data/catalog';
import { productPhoto } from '../../lib/product-photo';

/** What each tab holds, in one sentence. */
const INTRO: Record<string, string> = {
  'grand-public': 'Légers et faciles à prendre en main : pour débuter, voyager et filmer.',
  pro: 'Inspection, cartographie et cinéma : les plateformes professionnelles.',
  reglementation: 'La classe du drone dit où vous pouvez voler et quelle formation il vous faut.',
  capteurs: 'Caméras thermiques, LiDAR, zoom et RTK pour les drones Matrice.',
  accessoires: 'Batteries, recharge, pilotage, stockage et matériel de terrain.',
};
/** Clearer than "Par réglementation" for a customer. */
const LABEL: Record<string, string> = { reglementation: 'Selon votre permis' };
/** 24 × 24 line icons. */
const ICON: Record<string, string> = {
  'grand-public':
    '<circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="18" r="3"/><path d="M8.2 8.2 10 10M15.8 8.2 14 10M8.2 15.8 10 14M15.8 15.8 14 14"/><rect x="10" y="10" width="4" height="4"/>',
  pro: '<path d="M2 6h6M16 6h6M5 6v2h14V6"/><rect x="8" y="8" width="8" height="4.5"/><path d="M9 12.5 6.5 18M15 12.5l2.5 5.5M5 18h3M16 18h3"/><circle cx="12" cy="16" r="1.8"/>',
  reglementation: '<path d="M12 3 19 6v5c0 4.6-3 8.3-7 10-4-1.7-7-5.4-7-10V6z"/><path d="m8.6 12 2.4 2.4 4.4-4.8"/>',
  capteurs: '<path d="M12 3v3"/><rect x="5" y="6" width="14" height="11"/><circle cx="12" cy="11.5" r="3.2"/><path d="M9 20h6"/>',
  accessoires: '<rect x="3" y="7" width="16" height="10"/><path d="M21 10.5v3M7 10v4M10.5 10v4"/>',
};

const tabs = await Promise.all(
  SHOP_MENU.map(async (tab) => ({
    ...tab,
    label: LABEL[tab.id] ?? tab.label,
    intro: INTRO[tab.id] ?? '',
    icon: ICON[tab.id] ?? '',
    tiles: (
      await Promise.all(
        tab.tiles.map(async (tile) => {
          const items = forSale.filter(tile.match);
          // The cheapest product shows best what the category is (the drone alone, not a pack).
          const pick = [...items].sort((a, b) => a.priceTTC - b.priceTTC).find((p) => productImages(p).length > 0);
          const badge = tab.id === 'reglementation' ? tile.label.replace(/^Classes? /, '').replace(' et ', ' · ') : null;
          const photo = !badge && pick ? await productPhoto(pick, 1) : null;
          return { ...tile, count: items.length, photo, badge };
        }),
      )
    ).filter((t) => t.count > 0),
  })),
);
---

<section class="cats" aria-labelledby="cats-title" data-mega>
  <div class="wrap">
    <h2 id="cats-title" class="hud-text kicker">Parcourir par catégorie</h2>

    <div class="seg-scroll">
      <div class="seg" role="tablist" aria-label="Catégories de la boutique">
        <span class="seg-ind" aria-hidden="true"></span>
        {
          tabs.map((tab, i) => (
            <button type="button" role="tab" id={`tab-${tab.id}`} aria-controls={`panel-${tab.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={tab.icon} />
              {tab.label}
            </button>
          ))
        }
      </div>
    </div>

    {
      tabs.map((tab, i) => (
        <div class="panel" role="tabpanel" id={`panel-${tab.id}`} aria-labelledby={`tab-${tab.id}`} data-active={i === 0 || undefined}>
          <p class="nojs-title">{tab.label}</p>
          <p class="intro">{tab.intro}</p>
          <ul class="cards">
            {tab.tiles.map((tile, k) => (
              <li class="card" style={{ '--k': k }}>
                <a href={`/boutique/?filtre=${tile.id}#catalogue`} data-goto-filter={tile.id}>
                  {tile.badge ? (
                    <span class:list={['media badge', tile.badge.length > 3 && 'long']} aria-hidden="true">
                      {tile.badge}
                    </span>
                  ) : (
                    <span class="media">{tile.photo && <img src={tile.photo.src} srcset={tile.photo.srcset} sizes="(min-width: 1100px) 190px, (min-width: 768px) 30vw, 44vw" alt="" loading="lazy" decoding="async" />}</span>
                  )}
                  <span class="body">
                    <span class="name">{tile.label}</span>
                    <span class="text">{tile.text}</span>
                    <span class="count hud-text">
                      {tile.count} produit{tile.count > 1 ? 's' : ''} <span aria-hidden="true">→</span>
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="help">
      <Image src={popHead} alt="" width={48} densities={[1, 2]} class="help-pop" />
      <p>Vous hésitez entre deux modèles ?</p>
      <button type="button" class="help-btn" data-pop-open data-pop-ask="Quel drone choisir ?">Pop vous aide à choisir</button>
      <a href="#catalogue" class="help-all">Voir les {forSale.length} produits <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .cats {
    padding-block: clamp(36px, 4.5vw, 64px);
    text-align: center;
    background: var(--color-mist);
    border-bottom: 1px solid var(--color-line);
  }
  .kicker {
    color: var(--color-muted);
    text-transform: uppercase;
  }

  /* ---------- Segmented control ---------- */
  /* Centred when it fits; scrolls from the left edge when it does not (auto margins). */
  .seg-scroll {
    display: flex;
    margin-top: 16px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .seg-scroll::-webkit-scrollbar {
    display: none;
  }
  .seg {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    margin-inline: auto;
    padding: 4px;
    background: #fff;
    border: 1px solid var(--color-line);
  }
  .seg button {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 46px;
    padding: 0 18px;
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
    color: var(--color-ink-soft);
    cursor: pointer;
    transition: color 250ms ease;
  }
  .seg svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }
  .seg button[aria-selected='true'] {
    color: #fff;
  }
  @media (hover: hover) and (pointer: fine) {
    .seg button[aria-selected='false']:hover {
      color: var(--color-ink);
      background: var(--color-mist);
    }
  }
  .seg button:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: -2px;
  }
  /* The black block slides to the open tab (placed by the script). */
  .seg-ind {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    width: var(--w, 0);
    background: var(--color-ink);
    transform: translateX(var(--x, 0));
    transition:
      transform 400ms var(--ease-out-strong),
      width 400ms var(--ease-out-strong);
  }
  /* Before the script runs (or without it): the open tab is simply black. */
  .seg:not([data-ready]) button[aria-selected='true'] {
    background: var(--color-ink);
  }
  .seg:not([data-ready]) .seg-ind {
    display: none;
  }

  /* ---------- Panels ---------- */
  .panel {
    display: none;
  }
  .panel[data-active] {
    display: block;
  }
  .nojs-title {
    display: none;
  }
  :global(html:not(.js)) .panel {
    display: block;
    margin-top: 40px;
  }
  :global(html:not(.js)) .nojs-title {
    display: block;
    font-weight: 700;
    font-size: 20px;
  }
  .intro {
    max-width: 56ch;
    text-wrap: balance;
    margin: 18px auto 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }

  /* Phones: one row to scroll sideways, edge to edge. */
  .cards {
    display: flex;
    gap: 12px;
    margin: 26px calc(-1 * clamp(16px, 4.5vw, 56px)) 0;
    padding: 4px clamp(16px, 4.5vw, 56px) 10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: clamp(16px, 4.5vw, 56px);
    scrollbar-width: none;
  }
  .cards::-webkit-scrollbar {
    display: none;
  }
  .card {
    flex: 0 0 44%;
    scroll-snap-align: start;
  }
  /* Larger screens: centred rows, whatever the number of categories. */
  @media (min-width: 768px) {
    .cards {
      flex-wrap: wrap;
      justify-content: center;
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
    .card {
      flex: 0 0 calc((100% - 2 * 12px) / 3);
    }
  }
  @media (min-width: 900px) {
    .card {
      flex-basis: calc((100% - 3 * 12px) / 4);
    }
  }
  @media (min-width: 1100px) {
    .card {
      flex-basis: calc((100% - 5 * 12px) / 6);
    }
  }

  .card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    box-shadow: 0 1px 0 var(--color-line);
    transition:
      transform 300ms var(--ease-out-strong),
      box-shadow 300ms ease;
  }
  /* Product shots are on (nearly) white: multiplied over a light grey, their edges vanish. */
  .media {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    overflow: hidden;
    background: #f6f6f4;
  }
  .media img {
    width: 88%;
    height: 88%;
    object-fit: contain;
    mix-blend-mode: multiply;
    transition: transform 500ms var(--ease-out-strong);
  }
  /* The permit tab shows the class itself. */
  .badge {
    color: #fff;
    background: var(--color-ink);
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    font-weight: 800;
    font-stretch: 125%;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .badge.long {
    font-size: clamp(1.7rem, 2.6vw, 2.2rem);
  }
  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    padding: 14px 14px 16px;
  }
  .name {
    font-size: 16px;
    font-weight: 700;
    font-stretch: 112%;
    line-height: 1.2;
  }
  .text {
    text-wrap: balance;
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--color-muted);
  }
  .count {
    margin-top: auto;
    padding-top: 8px;
    color: var(--color-gold-deep);
  }
  .count span {
    display: inline-block;
    transition: transform 200ms var(--ease-out-strong);
  }
  @media (hover: hover) and (pointer: fine) {
    .card a:hover {
      transform: translateY(-4px);
      box-shadow: 0 18px 36px -18px rgb(0 0 0 / 0.28);
    }
    .card a:hover .media img {
      transform: scale(1.06);
    }
    .card a:hover .count span {
      transform: translateX(3px);
    }
  }
  .card a:focus-visible,
  .help-btn:focus-visible,
  .help-all:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
  }
  /* A new tab: its cards come in one after the other. */
  .panel[data-active] .card {
    animation: card-in 420ms var(--ease-out-strong) backwards;
    animation-delay: calc(var(--k) * 35ms);
  }
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* ---------- Help ---------- */
  .help {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 16px;
    margin-top: 28px;
    font-size: 15px;
  }
  .help-pop {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 2px var(--color-gold);
  }
  .help-btn {
    min-height: 40px;
    padding: 0 16px;
    font-weight: 700;
    color: #fff;
    background: var(--color-ink);
    cursor: pointer;
    transition: background-color 150ms ease-out;
  }
  .help-all {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-gold);
  }
  @media (hover: hover) and (pointer: fine) {
    .help-btn:hover {
      background: #262626;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel[data-active] .card {
      animation: none;
    }
    .seg-ind,
    .card a,
    .media img,
    .count span {
      transition: none;
    }
  }
</style>

<script>
  // Tabs: click, or arrows / Home / End; the black block slides to the open tab.
  document.querySelectorAll<HTMLElement>('[data-mega]').forEach((mega) => {
    const seg = mega.querySelector<HTMLElement>('.seg')!;
    const tabs = [...mega.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...mega.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    const ind = mega.querySelector<HTMLElement>('.seg-ind')!;
    const place = (tab: HTMLElement) => {
      ind.style.setProperty('--x', `${tab.offsetLeft - 4}px`);
      ind.style.setProperty('--w', `${tab.offsetWidth}px`);
    };
    const select = (i: number, focus = false) => {
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      panels.forEach((p, k) => p.toggleAttribute('data-active', k === i));
      place(tabs[i]);
      // On phones the control scrolls: keep the open tab in view.
      tabs[i].scrollIntoView({ block: 'nearest', inline: 'nearest' });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        const to = { ArrowRight: (i + 1) % n, ArrowLeft: (i - 1 + n) % n, Home: 0, End: n - 1 }[e.key];
        if (to !== undefined) {
          e.preventDefault();
          select(to, true);
        }
      });
    });
    place(tabs[0]);
    // No slide on the first placement.
    requestAnimationFrame(() => seg.setAttribute('data-ready', ''));
    addEventListener('resize', () => place(tabs.find((t) => t.getAttribute('aria-selected') === 'true')!));
  });
</script>
