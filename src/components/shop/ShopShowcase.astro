---
// Top of /boutique/ (client request, 2026-11-20: "no dynamism, no picture that makes you
// want to buy"): a showcase of the best sellers, big photo, name, promise and starting
// price, changing every 6.5 s with a progress bar under each name. It pauses on hover, on
// focus and with its button; swipe on touch screens. Reduced motion: no autoplay, no zoom.
// The search stays at the top, as on the current site. Without JavaScript the first slide
// shows and the names link to their family below.
import { Image } from 'astro:assets';
import Square from '../ui/Square.astro';
import SearchBox from './SearchBox.astro';
import { FAMILIES, SHOWCASE, fromPrice, versionsOf } from '../../data/shop';
import { formatPrice, productUrl } from '../../data/catalog';

const slides = SHOWCASE.map((s) => {
  const family = FAMILIES.find((f) => f.id === s.family)!;
  const versions = versionsOf(family);
  const standard = versions.find((p) => !/c5/i.test(p.name)) ?? versions[0];
  return { ...s, from: fromPrice(versions), count: versions.length, href: standard ? productUrl(standard) : `#famille-${family.id}`, anchor: `#famille-${family.id}` };
});
---

<section class="showcase" aria-labelledby="shop-title" data-showcase>
  <div class="wrap top">
    <div>
      <nav aria-label="Fil d’Ariane" class="hud-text crumbs">
        <a href="/">Accueil</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Boutique</span>
      </nav>
      <h1 id="shop-title" class="display title">
        <Square color="var(--color-paper)" class="mt-[0.22em] size-[0.32em] shrink-0" />
        Boutique drones et accessoires
      </h1>
    </div>
    <div class="search">
      <SearchBox types={['vente']} placeholder="Mavic 4 Pro, batterie Mini 5, kit C5…" action="/boutique/" />
    </div>
  </div>

  <div class="wrap stage" data-stage aria-roledescription="carrousel" aria-label="Nos meilleures ventes">
    {
      slides.map((s, i) => (
        <article class="slide" id={`vitrine-${i}`} data-slide aria-roledescription="diapositive" aria-label={`${i + 1} sur ${slides.length} : ${s.title}`} data-active={i === 0 || undefined}>
          <div class="copy">
            <p class="label hud-text">
              <Square color="var(--color-gold)" class="size-[8px]" />
              {s.label}
            </p>
            <h2 class="display name">{s.title}</h2>
            <p class="text">{s.text}</p>
            {s.from !== null && (
              <p class="price">
                <span>À partir de</span> <strong>{formatPrice(s.from)} TTC</strong>
                {s.count > 1 && <span class="count"> · {s.count} versions</span>}
              </p>
            )}
            <div class="actions">
              <a href={s.href} class="btn gold" tabindex={i === 0 ? undefined : -1}>
                Découvrir <span aria-hidden="true">→</span>
              </a>
              <a href={s.anchor} class="btn line" tabindex={i === 0 ? undefined : -1}>
                Comparer les versions
              </a>
            </div>
          </div>
          <div class="photo viewfinder">
            <Image src={s.photo} alt="" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 56vw, 100vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} style={{ objectPosition: s.focus ?? '50% 50%' }} />
          </div>
        </article>
      ))
    }

    <div class="controls">
      <div class="tabs" role="tablist" aria-label="Choisir un drone">
        {
          slides.map((s, i) => (
            <a href={s.anchor} role="tab" class="tab" data-tab={i} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`vitrine-${i}`}>
              <span class="bar" aria-hidden="true"></span>
              <span class="tab-name">{s.title.replace(/^DJI /, '')}</span>
              {s.from !== null && <span class="tab-price">dès {formatPrice(s.from)}</span>}
            </a>
          ))
        }
      </div>
      <button type="button" class="pause" data-pause aria-pressed="false" aria-label="Mettre le défilement en pause">
        <span class="i-pause" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-showcase]');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const tabs = [...root.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-pause]')!;
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DURATION = 6500;
    let current = 0;
    let timer = 0;
    let hold = false; // hover / focus
    let paused = reduced; // the button (or reduced motion)
    root.dataset.js = '';
    root.style.setProperty('--duration', `${DURATION}ms`);

    const show = (n: number) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const on = i === current;
        s.toggleAttribute('data-active', on);
        s.setAttribute('aria-hidden', String(!on));
        s.querySelectorAll('a').forEach((a) => (on ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
      });
      tabs.forEach((t, i) => {
        t.setAttribute('aria-selected', String(i === current));
        // Restart the progress bar of the selected name.
        const bar = t.querySelector<HTMLElement>('.bar')!;
        bar.classList.remove('run');
        void bar.offsetWidth;
        if (i === current) bar.classList.add('run');
      });
      schedule();
    };
    const schedule = () => {
      clearTimeout(timer);
      root.toggleAttribute('data-paused', paused || hold);
      if (!paused && !hold) timer = window.setTimeout(() => show(current + 1), DURATION);
    };

    tabs.forEach((t, i) =>
      t.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
      }),
    );
    pauseBtn.addEventListener('click', () => {
      paused = !paused;
      pauseBtn.setAttribute('aria-pressed', String(paused));
      pauseBtn.setAttribute('aria-label', paused ? 'Relancer le défilement' : 'Mettre le défilement en pause');
      // A fresh bar when it starts again.
      if (!paused) show(current);
      else schedule();
    });
    stage.addEventListener('pointerenter', () => ((hold = true), schedule()));
    stage.addEventListener('pointerleave', () => ((hold = false), show(current)));
    stage.addEventListener('focusin', () => ((hold = true), schedule()));
    stage.addEventListener('focusout', (e) => {
      if (!stage.contains(e.relatedTarget as Node)) (hold = false), show(current);
    });

    // Swipe between slides on touch screens.
    let x0: number | null = null;
    stage.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') x0 = e.clientX;
    });
    stage.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    });

    if (reduced) pauseBtn.hidden = true;
    show(0);
  }
</script>

<style>
  .showcase {
    position: relative;
    overflow: hidden;
    color: #fff;
    background: var(--color-ink);
    padding-block: clamp(20px, 3vw, 36px) clamp(32px, 4vw, 56px);
  }

  .top {
    display: grid;
    gap: 20px;
    align-items: end;
  }
  @media (min-width: 1024px) {
    .top {
      grid-template-columns: minmax(0, 1fr) minmax(320px, 440px);
    }
  }
  .crumbs {
    display: flex;
    gap: 10px;
    color: rgb(255 255 255 / 0.6);
  }
  .crumbs a:hover {
    color: #fff;
  }
  .title {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-top: 10px;
    font-size: clamp(1.6rem, 2.6vw, 2.4rem);
  }
  .search :global(form) {
    max-width: none;
  }

  /* ---------- Slides ---------- */
  .stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-top: clamp(24px, 3vw, 40px);
  }
  .slide {
    grid-area: 1 / 1;
    display: grid;
    gap: clamp(20px, 3vw, 48px);
    align-items: center;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 600ms ease,
      visibility 0s linear 600ms;
  }
  .slide[data-active] {
    visibility: visible;
    opacity: 1;
    transition:
      opacity 600ms ease,
      visibility 0s;
  }
  @media (min-width: 1024px) {
    .slide {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
  .copy {
    order: 2;
  }
  @media (min-width: 1024px) {
    .copy {
      order: 1;
    }
  }
  .label {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-gold);
  }
  .name {
    margin-top: 14px;
    font-size: clamp(2.3rem, 4.6vw, 4.4rem);
  }
  .text {
    max-width: 38ch;
    margin-top: 16px;
    font-size: 18px;
    line-height: 1.55;
    color: rgb(255 255 255 / 0.75);
  }
  .price {
    margin-top: 20px;
    font-size: 15px;
    color: rgb(255 255 255 / 0.65);
  }
  .price strong {
    font-size: 22px;
    color: #fff;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 22px;
    font-size: 15px;
    font-weight: 600;
    transition:
      background-color 150ms ease-out,
      border-color 150ms ease-out;
  }
  .btn.gold {
    color: var(--color-ink);
    background: var(--color-gold);
  }
  .btn.line {
    border: 1px solid rgb(255 255 255 / 0.35);
  }
  .btn span {
    display: inline-block;
    transition: transform 200ms var(--ease-out-strong);
  }
  @media (hover: hover) and (pointer: fine) {
    .btn.gold:hover {
      background: #c29a5f;
    }
    .btn.gold:hover span {
      transform: translateX(3px);
    }
    .btn.line:hover {
      border-color: #fff;
    }
  }

  .photo {
    order: 1;
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #111;
  }
  @media (min-width: 1024px) {
    .photo {
      order: 2;
      aspect-ratio: 16 / 11;
    }
  }
  .photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* A slow push-in while the slide is shown. */
  @media (prefers-reduced-motion: no-preference) {
    .slide[data-active] .photo :global(img) {
      animation: push var(--duration, 6500ms) linear both;
    }
    .showcase[data-paused] .slide[data-active] .photo :global(img) {
      animation-play-state: paused;
    }
  }
  @keyframes push {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1);
    }
  }

  /* ---------- Names with their progress bar ---------- */
  .controls {
    display: flex;
    align-items: stretch;
    gap: 12px;
    margin-top: clamp(24px, 3vw, 36px);
  }
  .tabs {
    flex: 1;
    min-width: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(150px, 1fr);
    gap: 12px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar {
    display: none;
  }
  .tab {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 14px;
    color: rgb(255 255 255 / 0.55);
    transition: color 150ms ease-out;
  }
  .tab[aria-selected='true'] {
    color: #fff;
  }
  .tab:focus-visible,
  .pause:focus-visible,
  .btn:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
  }
  @media (hover: hover) and (pointer: fine) {
    .tab:hover {
      color: #fff;
    }
  }
  .bar {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: rgb(255 255 255 / 0.2);
    overflow: hidden;
  }
  .bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: left;
  }
  .tab[aria-selected='true'] .bar::after {
    transform: scaleX(1);
  }
  .showcase[data-js] .bar.run::after {
    animation: fill var(--duration, 6500ms) linear both;
  }
  .showcase[data-paused] .bar.run::after {
    animation-play-state: paused;
  }
  @keyframes fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  .tab-name {
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
  }
  .tab-price {
    font-size: 13px;
    color: rgb(255 255 255 / 0.5);
    white-space: nowrap;
  }
  .pause {
    flex-shrink: 0;
    align-self: flex-end;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgb(255 255 255 / 0.25);
    cursor: pointer;
  }
  .i-pause {
    width: 10px;
    height: 12px;
    border-inline: 3px solid #fff;
  }
  .pause[aria-pressed='true'] .i-pause {
    width: 0;
    height: 0;
    border-block: 7px solid transparent;
    border-inline: 0;
    border-left: 11px solid #fff;
    margin-left: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .slide,
    .slide[data-active] {
      transition: none;
    }
    .showcase[data-js] .bar.run::after {
      animation: none;
    }
  }
</style>
