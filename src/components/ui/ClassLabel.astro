---
// The official class identification label of EU drones (Regulation (EU) 2019/945, C5 and C6
// added by 2020/1058): the class digit in a circle, three lines on each side. Redrawn as an
// SVG from the published label (client sent it on 2026-11-21), proportions measured on it:
// circle Ø 115, lines 4 thick, 13.5 apart, reaching 129 / 114 / 98 from the centre.
interface Props {
  /** The class digit, "0" to "6". */
  digit: string;
  class?: string;
}
const { digit, class: className } = Astro.props;
---

<svg viewBox="-132 -60 264 120" class:list={['class-label', className]} aria-hidden="true">
  <path d="M-129 -13.5H-54M-114 0H-55.5M-98 13.5H-54M129 -13.5H54M114 0H55.5M98 13.5H54" fill="none" stroke="currentColor" stroke-width="4"></path>
  <circle r="55.75" fill="none" stroke="currentColor" stroke-width="3.5"></circle>
  <text y="28.6" text-anchor="middle" font-family="Arial, 'Helvetica Neue', Helvetica, 'Liberation Sans', sans-serif" font-size="80" font-weight="700" fill="currentColor">{digit}</text>
</svg>
