---
// A drone's class on its photos, as the official EU labels (client, 2026-11-21: "the
// pictograms rather than the text"): "C2" → one label, "C0/C1" or "C2 / C6" → two, with
// a white circle and halo so they read on any photo. Screen readers and the tooltip get
// the words. Size with --label-w (width of one label).
import ClassLabel from './ClassLabel.astro';

interface Props {
  /** As given by droneClass(): "C2", "C0/C1", "C2 / C6"… */
  cls: string;
  class?: string;
}
const { cls, class: className } = Astro.props;
const digits = [...cls.matchAll(/C(\d)/g)].map((m) => m[1]);
const text = `Classe ${cls.replace(/\s*\/\s*/g, ' ou ')}`;
---

<span class:list={['class-badge', className]} role="img" aria-label={text} title={text}>
  {digits.map((d) => <ClassLabel digit={d} />)}
</span>

<style>
  /* No plate (client, 2026-11-21: a white box shows on lifestyle photos): the circle is
     white inside, as on the official label, and a thin white halo keeps the lines readable
     on any photo. */
  .class-badge {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--label-w, 60px) * 0.12);
    color: var(--color-ink);
  }
  .class-badge :global(.class-label) {
    display: block;
    width: var(--label-w, 60px);
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 0 1px #fff) drop-shadow(0 0 1px #fff);
  }
  .class-badge :global(.class-label circle) {
    fill: #fff;
  }
</style>
