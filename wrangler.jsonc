// Astro builds to dist/: the static pages are served as Workers static assets, and the
// account area (/connexion/, /compte/, /admin/) runs in the Worker (Astro's Cloudflare
// adapter fills in "main" and the ASSETS binding).
// html_handling keeps the WordPress-style trailing-slash URLs (/prestations/).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lesdroneslyonnais",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  // Every branch pushed to GitHub gets its own preview link
  // (<version>-lesdroneslyonnais.<subdomain>.workers.dev), shown in the
  // Cloudflare check on the commit, so a change can be reviewed before it reaches main.
  "workers_dev": true,
  // Worker logs in the Cloudflare dashboard (e-mail failures are logged as "[mail] …").
  "observability": { "enabled": true },
  "preview_urls": true,
  // Astro sessions (the Cloudflare adapter stores them in the SESSION KV namespace).
  // Previews (`wrangler preview`) need the id: they do not create missing resources.
  "kv_namespaces": [{ "binding": "SESSION", "id": "51e51b0db98c42bc85abe6e566a8bea3" }],
  // Accounts, sign-in links, sessions, orders, invoices, missions, deliverables.
  // Schema: migrations/. Local copy: npm run db:migrate (in .wrangler/, not committed).
  // Remote (created 2026-11-19, Western Europe): npx wrangler d1 migrations apply ldl-accounts --remote
  "d1_databases": [{ "binding": "DB", "database_name": "ldl-accounts", "database_id": "b77b84a6-b698-4a13-9e5d-e94d70dbb663", "migrations_dir": "migrations" }],
  // Branch previews (`wrangler preview`) do not inherit bindings: they are repeated here
  // (same KV and D1 as production for now: no real data yet). Without the SESSION entry,
  // the Astro adapter adds one with no id and every preview deployment is refused.
  "previews": {
    "kv_namespaces": [{ "binding": "SESSION", "id": "51e51b0db98c42bc85abe6e566a8bea3" }],
    "d1_databases": [{ "binding": "DB", "database_name": "ldl-accounts", "database_id": "b77b84a6-b698-4a13-9e5d-e94d70dbb663", "migrations_dir": "migrations" }]
  },
  // Private files (invoice PDFs, deliverables): no R2 bucket. They move to Supabase Storage
  // with the accounts (shared with the LDL Academy app); until then uploads and downloads
  // answer "bientôt disponible".
  // Administrators: ADMIN_EMAILS, comma-separated e-mails that become admins on first
  // sign-in. Not stored here: locally in .dev.vars (not committed), in production as a
  // secret (`npx wrangler secret put ADMIN_EMAILS`).
}
